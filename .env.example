# Google Apps Script web app that appends leads to a Google Sheet (backup copy).
# See google-sheets-integration/README.md. Read on the server only.
VITE_LEADS_WEBHOOK_URL=

# API key for the HeiGin inbound leads API (https://api.heigin.com/integrations/inbound/leads).
