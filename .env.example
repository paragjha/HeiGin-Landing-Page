# Google Apps Script web app that appends leads to a Google Sheet (backup copy).
# See google-sheets-integration/README.md. Read on the server only.
VITE_LEADS_WEBHOOK_URL=

# API key for the HeiGin inbound leads API (https://api.heigin.com/integrations/inbound/leads).
# Server-only secret: never prefix with VITE_, or it would ship to the browser.
HEIGIN_LEADS_API_KEY=

# Strapi CMS that holds the Blog articles (see docs/strapi-setup.md).
# STRAPI_URL is the project's base URL, e.g. https://my-project.strapiapp.com
# STRAPI_API_TOKEN is a Read-only API token. Both are server-only: never prefix with VITE_.
# Leave both empty and /blog shows the planned-topics list.
STRAPI_URL=
STRAPI_API_TOKEN=
